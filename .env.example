# Identifiants Sanity (publics, ils sont aussi dans astro.config.mjs)
PUBLIC_SANITY_PROJECT_ID=4lcj5kde
PUBLIC_SANITY_DATASET=production
# Jeton avec le rôle "editor", uniquement pour scripts/import-wordpress.mjs
# À créer sur https://www.sanity.io/manage/project/4lcj5kde/api#tokens
SANITY_WRITE_TOKEN=
# URL publique du site (utilisée pour le sitemap et le flux RSS)
PUBLIC_SITE_URL=https://lesoudeboege.fr
