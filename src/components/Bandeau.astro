---
/**
 * Le mot punaisé en haut de toutes les pages : un bout de papier tenu par une
 * punaise, écrit à la main. Il n'apparaît que si « Afficher le bandeau » est
 * coché dans Paramètres du site.
 */
import type { Annonce } from '../lib/sanity';
interface Props { annonce?: Annonce }
const { annonce } = Astro.props;
const visible = Boolean(annonce?.actif && annonce?.texte);
const ton = annonce?.ton ?? 'info';
---
{visible && (
  <div class:list={['bandeau', `bandeau--${ton}`]} role={ton === 'alerte' ? 'alert' : 'status'}>
    <div class="container bandeau__papier">
      <span class="bandeau__punaise" aria-hidden="true"></span>
      <p class="bandeau__texte">
        {annonce!.texte}
        {annonce!.lien && <a class="bandeau__lien" href={annonce!.lien}>{annonce!.libelleLien || 'En savoir plus'}</a>}
      </p>
    </div>
  </div>
)}

<style>
  .bandeau {
    --papier-note: #fff6d1;
    --fil: #e9d98f;
    background: var(--papier-2);
    border-bottom: 1px solid var(--ligne);
  }
  .bandeau--alerte { --papier-note: #fde4df; --fil: #efb3a8; }
  .bandeau--bonne { --papier-note: #e6f3e2; --fil: #b5d9ad; }
  .bandeau__papier {
    position: relative;
    display: flex; justify-content: center;
    padding: 0.55rem var(--gouttiere) 0.6rem;
  }
  .bandeau__texte {
    position: relative;
    display: inline-flex; flex-wrap: wrap; justify-content: center; align-items: baseline; gap: 0.3rem 0.8rem;
    padding: 0.45rem 1.3rem 0.5rem 2.4rem;
    background: var(--papier-note);
    border: 1px solid var(--fil);
    border-radius: 3px;
    box-shadow: 0 2px 3px rgba(36, 48, 44, 0.12), 0 8px 16px -10px rgba(36, 48, 44, 0.35);
    transform: rotate(-0.6deg);
    font-family: var(--craie-police); font-weight: 600; font-size: clamp(1.15rem, 1rem + 0.5vw, 1.4rem); line-height: 1.25;
    color: var(--encre);
    text-wrap: balance;
  }
  .bandeau__punaise {
    position: absolute; z-index: 1;
    top: 0.35rem; left: calc(50% - 0.5rem);
    width: 1.1rem; height: 1.1rem; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #ff9b8c, var(--rouge) 55%, #a8372a);
    box-shadow: 0 2px 3px rgba(0, 0, 0, 0.35);
  }
  @supports (anchor-name: --p) {
    .bandeau__texte { anchor-name: --p; }
    .bandeau__punaise { position-anchor: --p; left: anchor(left); top: anchor(top); translate: 0.65rem -0.2rem; }
  }
  .bandeau__lien { color: var(--ardoise); text-decoration-thickness: 2px; text-underline-offset: 3px; }
  .bandeau__lien:hover { color: var(--rouge); }
  @media (prefers-reduced-motion: no-preference) {
    .bandeau__texte { animation: bandeau-pose 400ms cubic-bezier(0.2, 0.8, 0.3, 1.2) both; }
    @keyframes bandeau-pose {
      from { opacity: 0; transform: translateY(-6px) rotate(-2deg); }
      to { opacity: 1; transform: translateY(0) rotate(-0.6deg); }
    }
  }
</style>
