---
import Base from '../layouts/Base.astro';
---
<Base titre="Page introuvable">
  <div class="container page">
    <h1>Cette page n’existe pas</h1>
    <p>Elle a peut-être été déplacée. Retournez à <a href="/">l’accueil</a> ou parcourez <a href="/actualites">les actualités</a>.</p>
  </div>
</Base>
<style>
  .page { margin-top: 4rem; display: grid; gap: 1rem; max-width: 40rem; }
</style>
