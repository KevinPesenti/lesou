---
import Base from '../layouts/Base.astro';
import { getBureau, getParametres, urlFor } from '../lib/sanity';
const [tous, params] = await Promise.all([getBureau(), getParametres()]);
const estHonneur = (m: { role: string }) => /honneur/i.test(m.role);
const membres = tous.filter((m) => !estHonneur(m));
const honneur = tous.filter(estHonneur);
---
<Base titre="Le bureau" description="Les parents bénévoles qui animent le Sou des écoles de Boëge.">
  <div class="container page">
    <header class="entete">
      <h1>Le bureau</h1>
      <p class="intro">
        Des parents bénévoles, élus chaque année lors de l’assemblée générale.{' '}
        {params?.email && <>Une question, une envie de donner un coup de main ? Écrivez-nous à <a href={`mailto:${params.email}`}>{params.email}</a>.</>}
      </p>
    </header>
    {membres.length > 0 ? (
      <ul class="membres">
        {membres.map((m, i) => (
          <li class="membre" style={`--teinte: var(--${['rouge', 'orange', 'jaune', 'vert', 'bleu'][i % 5]})`}>
            {m.photo?.asset ? (
              <img class="membre__photo" src={urlFor(m.photo).width(320).height(320).fit('crop').url()} alt="" width="160" height="160" loading="lazy" />
            ) : (
              <span class="membre__photo membre__photo--vide" aria-hidden="true">{m.nom.trim().charAt(0)}</span>
            )}
            <span class="membre__nom">{m.nom}</span>
            <span class="membre__role">{m.role}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p class="vide">La composition du bureau sera publiée après la prochaine assemblée générale.</p>
    )}

    {honneur.length > 0 && (
      <section class="honneur" aria-labelledby="honneur-titre">
        <h2 id="honneur-titre">Membres d’honneur</h2>
        <p class="intro">Le Sou remercie celles et ceux qui l’ont fait vivre et qui continuent de l’accompagner.</p>
        <ul class="membres membres--honneur">
          {honneur.map((m, i) => (
            <li class="membre" style={`--teinte: var(--${['bleu', 'vert', 'jaune', 'orange', 'rouge'][i % 5]})`}>
              {m.photo?.asset ? (
                <img class="membre__photo" src={urlFor(m.photo).width(320).height(320).fit('crop').url()} alt="" width="160" height="160" loading="lazy" />
              ) : (
                <span class="membre__photo membre__photo--vide" aria-hidden="true">{m.nom.trim().charAt(0)}</span>
              )}
              <span class="membre__nom">{m.nom}</span>
              <span class="membre__role">{m.role}</span>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>

<style>
  .page { margin-top: 2.5rem; display: grid; gap: 2.5rem; }
  .entete { display: grid; gap: 0.8rem; }
  .intro { max-width: var(--mesure); color: var(--encre-2); font-size: 1.1rem; }
  .membres {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 2rem 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
  }
  .membre { display: grid; justify-items: center; text-align: center; gap: 0.2rem; }
  .membre__photo {
    width: 8rem; height: 8rem; border-radius: 50%; object-fit: cover; margin-bottom: 0.6rem;
    background: var(--papier-2);
  }
  .membre__photo--vide {
    display: grid; place-items: center;
    background: color-mix(in srgb, var(--teinte) 22%, white); color: var(--ardoise);
    font-family: var(--titre-police); font-variation-settings: 'wght' 600; font-size: 2.6rem;
    border: 4px solid var(--teinte);
  }
  .membre__nom { font-family: var(--titre-police); font-variation-settings: 'wght' 500; font-size: 1.1rem; }
  .membre__role { color: var(--encre-2); font-size: 0.95rem; }
  .vide { color: var(--encre-2); }
  .honneur { display: grid; gap: 1.2rem; padding-top: 2rem; border-top: 3px dotted var(--ligne); }
  .membres--honneur .membre__photo { width: 6.5rem; height: 6.5rem; }
  .membres--honneur .membre__photo--vide { font-size: 2.1rem; }
</style>
